{
  "name": "bangkok-traffic-live",
  "version": "1.0.0",
  "description": "Bangkok traffic cameras from Longdo, with vehicle detection",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "share": "node tunnel/share.js",
    "share:ts": "tailscale funnel --bg 3000",
    "log:traffic": "node logger/log-traffic.js",
    "log:once": "node logger/log-traffic.js --once",
    "detect": "detector/.venv/Scripts/python.exe detector/detect.py --weights detector/weights/yolo11x.pt",
    "record": "detector/.venv/Scripts/python.exe recorder/record.py",
    "record:once": "detector/.venv/Scripts/python.exe recorder/record.py --once"
  },
  "keywords": [
    "cctv",
    "bangkok",
    "traffic",
    "longdo",
    "hls",
    "yolo"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "engines": {
    "node": ">=20.x"
  }
}
