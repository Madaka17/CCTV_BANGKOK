{
  "name": "bangkok-traffic-live",
  "version": "1.0.0",
  "description": "Live Bangkok traffic video and road conditions",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "share": "node tunnel/share.js",
    "share:ts": "tailscale funnel --bg 3000",
    "py": "python3 server.py",
    "log:traffic": "node logger/log-traffic.js",
    "log:once": "node logger/log-traffic.js --once"
  },
  "keywords": [
    "cctv",
    "bma",
    "bangkok",
    "traffic",
    "mjpeg",
    "dashboard"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "engines": {
    "node": ">=20.x"
  }
}
